{
  "name": "averenium-nuget-manager",
  "displayName": "AVE NuGet Manager",
  "description": "NuGet package manager for .NET solutions: search, install, update package families, audit vulnerabilities and edit nuget.config from one panel. Requires the .NET SDK.",
  "version": "0.7.5",
  "publisher": "averenium",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "pricing": "Free",
  "homepage": "https://github.com/averenium/Ave-Nuget-Manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/averenium/Ave-Nuget-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/averenium/Ave-Nuget-Manager/issues"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "nuget",
    "nuget manager",
    "nuget package manager",
    "package manager",
    "packages",
    "packagereference",
    "nuget.config",
    "dotnet",
    ".net",
    "c#",
    "csharp",
    "f#",
    "fsharp",
    "dependencies",
    "dependency management",
    "update packages",
    "outdated",
    "vulnerabilities",
    "security audit",
    "restore",
    "solution",
    "csproj",
    "msbuild"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs `dotnet` against workspace project files."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "workspaceContains:*.sln",
    "workspaceContains:*.slnx",
    "workspaceContains:*.csproj",
    "workspaceContains:*.fsproj",
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/*.fsproj",
    "onView:averenium.nugetManagerView",
    "onCommand:averenium.nugetManager.open",
    "onCommand:averenium.nugetManager.openInEditor",
    "onCommand:averenium.nugetManager.openInNewWindow",
    "onCommand:averenium.nugetManager.openSettings",
    "onCommand:averenium.nugetManager.installAgentSkill",
    "onCommand:averenium.nugetManager.startTrace",
    "onCommand:averenium.nugetManager.stopTrace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "AVE NuGet Manager",
      "properties": {
        "averenium.nugetManager.includePrerelease": {
          "type": "boolean",
          "default": false,
          "description": "Include pre-release packages in search results"
        },
        "averenium.nugetManager.dotnetConcurrency": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "markdownDescription": "Maximum number of parallel `dotnet` processes (list, search, enrich, install, remove, restore)."
        },
        "averenium.nugetManager.onFailedUpdate": {
          "type": "string",
          "enum": [
            "rollback",
            "keep"
          ],
          "default": "rollback",
          "markdownDescription": "When a package update writes the project file but restore fails (e.g. NU1605):\n\n- **rollback**: restore the previous `PackageReference` (and `Directory.Packages.props` if it changed).\n- **keep**: leave the new version and show a **Rollback** button in the error banner."
        },
        "averenium.nugetManager.vulnerabilityScript": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional script that adds extra vulnerability findings. Receives a JSON snapshot on stdin (`scope`, `installed`, `implicit`) and must print a JSON array of findings (or `{ \"findings\": [...] }`) on stdout. Relative paths resolve from the workspace folder. See [docs/vulnerability-script.md](https://github.com/averenium/Ave-Nuget-Manager/blob/main/docs/vulnerability-script.md) for the finding shape and JavaScript/Python examples."
        },
        "averenium.nugetManager.blockedPackages": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Package ids that must not change version in **this workspace** (written to `.vscode/settings.json`). Applies to Packages **↑** and Groups All / family / Other. Remove and first-time install stay allowed. Right-click a package row to block or unblock."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "averenium-nuget-panel",
          "title": "NuGet",
          "icon": "$(package)"
        }
      ]
    },
    "views": {
      "averenium-nuget-panel": [
        {
          "id": "averenium.nugetManagerView",
          "name": "NuGet",
          "type": "webview",
          "when": "averenium.nugetManager.hasDotnetWorkspace && !averenium.nugetManager.editorOpen"
        }
      ]
    },
    "commands": [
      {
        "command": "averenium.nugetManager.open",
        "title": "NuGet Management",
        "category": "NuGet"
      },
      {
        "command": "averenium.nugetManager.openInEditor",
        "title": "Open in Editor",
        "category": "NuGet"
      },
      {
        "command": "averenium.nugetManager.openInNewWindow",
        "title": "Open in New Window",
        "icon": "$(empty-window)",
        "category": "NuGet"
      },
      {
        "command": "averenium.nugetManager.openSettings",
        "title": "Open Settings",
        "icon": "$(gear)",
        "category": "NuGet"
      },
      {
        "command": "averenium.nugetManager.installAgentSkill",
        "title": "SKILL -> Install Dependency Breaking Changes Review",
        "icon": "$(mortar-board)",
        "category": "NuGet"
      },
      {
        "command": "averenium.nugetManager.startTrace",
        "title": "Trace -> Start",
        "category": "NuGet"
      },
      {
        "command": "averenium.nugetManager.stopTrace",
        "title": "Trace -> Stop & save zip",
        "category": "NuGet"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "averenium.nugetManager.open",
          "when": "resourceExtname =~ /\\.(sln|slnx|csproj|fsproj)$/ || explorerResourceIsFolder",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "averenium.nugetManager.open",
          "title": "NuGet: Management",
          "when": "averenium.nugetManager.hasDotnetWorkspace"
        },
        {
          "command": "averenium.nugetManager.openInEditor",
          "when": "averenium.nugetManager.hasDotnetWorkspace || averenium.nugetManager.editorOpen"
        },
        {
          "command": "averenium.nugetManager.openInNewWindow",
          "when": "averenium.nugetManager.hasDotnetWorkspace || averenium.nugetManager.editorOpen"
        },
        {
          "command": "averenium.nugetManager.openSettings",
          "title": "NuGet: Open Settings"
        },
        {
          "command": "averenium.nugetManager.installAgentSkill",
          "title": "NuGet: SKILL -> Install Dependency Breaking Changes Review"
        },
        {
          "command": "averenium.nugetManager.startTrace",
          "title": "NuGet: Trace -> Start"
        },
        {
          "command": "averenium.nugetManager.stopTrace",
          "title": "NuGet: Trace -> Stop & save zip"
        }
      ],
      "view/title": [
        {
          "command": "averenium.nugetManager.openInNewWindow",
          "when": "view == averenium.nugetManagerView",
          "group": "navigation@1"
        },
        {
          "command": "averenium.nugetManager.openSettings",
          "when": "view == averenium.nugetManagerView",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "averenium.nugetManager.openInNewWindow",
          "when": "activeWebviewPanelId == averenium.nugetManager.editor",
          "group": "navigation@1"
        },
        {
          "command": "averenium.nugetManager.openSettings",
          "when": "activeWebviewPanelId == averenium.nugetManager.editor",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "tsc -p tsconfig.json",
    "build:webview": "npm run typecheck:webview && vite build --config vite.webview.config.ts",
    "watch": "npm run watch:ext & npm run watch:webview",
    "watch:ext": "tsc -p tsconfig.json --watch",
    "watch:webview": "vite build --config vite.webview.config.ts --watch",
    "test": "jest --runInBand",
    "test:unit": "jest --testPathPatterns='src/test/unit'",
    "test:property": "jest --testPathPatterns='src/test/property'",
    "lint": "eslint src",
    "typecheck": "npm run typecheck:ext && npm run typecheck:webview",
    "typecheck:ext": "tsc -p tsconfig.json --noEmit",
    "typecheck:webview": "tsc -p tsconfig.webview.json",
    "package": "vsce package --pre-release",
    "package:release": "vsce package",
    "publish:preview": "vsce publish --pre-release"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/vscode": "1.85.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vscode/vsce": "3.9.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.8.0",
    "jest": "30.4.2",
    "jsdom": "29.1.1",
    "ovsx": "^1.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ts-jest": "29.4.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  }
}
