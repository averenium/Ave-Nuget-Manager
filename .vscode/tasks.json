{
  "version": "2.0.0",
  "tasks": [
    {
      // ── Full one-shot build: ext host + webview ──────────────────────────────
      "label": "build:all",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$tsc"]
    },

    {
      // ── Extension host TypeScript only (fast re-build on change) ─────────────
      "label": "build:ext",
      "type": "shell",
      "command": "npm run build:ext",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    },

    {
      // ── Webview Vite build only ───────────────────────────────────────────────
      "label": "build:webview",
      "type": "shell",
      "command": "npm run build:webview",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    {
      // ── Watch: tsc --watch + vite build --watch ──────────────────────────────
      // Webview: save React/CSS → bundle rebuild → panel reloads HTML.
      // Host: after tsc rebuilds, reload the Extension Development Host (Ctrl+R).
      "label": "build:watch",
      "dependsOn": ["watch:ext", "watch:webview"],
      "dependsOrder": "parallel",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },

    {
      "label": "watch:ext",
      "type": "shell",
      "command": "npm run watch:ext",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "label": "tsc watch"
      },
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "applyTo": "closedDocuments",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting compilation in watch mode|Starting incremental compilation",
          "endsPattern": "Watching for file changes|Found 0 errors"
        }
      }
    },

    {
      "label": "watch:webview",
      "type": "shell",
      "command": "npm run watch:webview",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "label": "vite build watch"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite|build started",
          "endsPattern": "built in|watching for"
        }
      }
    },

    {
      // ── Run tests via terminal ────────────────────────────────────────────────
      "label": "test",
      "type": "shell",
      "command": "npm test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
