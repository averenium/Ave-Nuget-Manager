<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nexus-group" value="http://localhost:8081/repository/nuget-group/index.json" disableTLSCertificateValidation="true" allowInsecureConnections="true" />
  </packageSources>


  <disabledPackageSources>
    <add key="nexus-group" value="false" />
    <add key="nuget.org" value="false" />
  </disabledPackageSources>
</configuration>
