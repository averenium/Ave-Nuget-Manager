<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="example-internal" value="https://nuget.example.com/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Demo mapping: everything resolves from nuget.org, and the (fictional) internal
    feed owns the Example.* namespace only. No Example.* package is referenced, so
    restore never contacts that host.
  -->
  <!-- Disabled so the demo restores offline from nuget.org alone; toggling it back
       on in the Sources tab is part of the demo. -->
  <disabledPackageSources>
    <add key="example-internal" value="true" />
  </disabledPackageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="example-internal">
      <package pattern="Example.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
